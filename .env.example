# PostgreSQL 주소 (Neon, Supabase, Vercel Postgres 등)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance"

# 로그인 쿠키 암호화용. 아무 긴 문자열 (32자 이상)
SESSION_SECRET="여기에-아무-긴-문자열-32자-이상-넣기-abcdefg1234567"

# 솔라피 (https://solapi.com) — 비워두면 테스트 모드: 문자는 안 나가고 기록만 남음
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
# 솔라피 잔액(원)이 이만큼 밑으로 내려가면 출석부 위에 경고 (기본 5000)
SOLAPI_LOW_BALANCE="5000"

# 처음 계정 만들 때만 씀 (npm run seed)
SEED_ACADEMY_NAME="현샘영수"
SEED_LOGIN_ID="hyunsaem"
SEED_PASSWORD="바꿔주세요1234"
SEED_SENDER_PHONE="01000000000"
# 테스트용 예시 학생 5명 넣기 (실사용이면 false)
SEED_SAMPLE_STUDENTS="true"
