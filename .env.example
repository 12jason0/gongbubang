# PostgreSQL 주소 (Neon, Supabase, Vercel Postgres 등)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance"

# 로그인 쿠키 암호화용. 아무 긴 문자열 (32자 이상)
SESSION_SECRET="여기에-아무-긴-문자열-32자-이상-넣기-abcdefg1234567"

# 솔라피 (https://solapi.com) — 비워두면 테스트 모드: 문자는 안 나가고 기록만 남음
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
# 솔라피 잔액(원)이 이만큼 밑으로 내려가면 출석부 위에 경고 (기본 5000)
SOLAPI_LOW_BALANCE="5000"

# 카카오 알림톡 (비워두면 전부 문자로 나감) — README "카카오 알림톡" 참고
# 솔라피에 연동한 카카오 채널 ID (PF로 시작)
SOLAPI_KAKAO_PF_ID=""
# 승인된 템플릿 ID (KA로 시작). 넣은 종류만 알림톡으로 바뀜
SOLAPI_TEMPLATE_ATTENDANCE=""
SOLAPI_TEMPLATE_FEEDBACK=""
SOLAPI_TEMPLATE_PAYMENT=""
SOLAPI_TEMPLATE_SCHEDULE=""   # 수업 일정 안내 (휴원·보강·수업 시간 변경)
SOLAPI_TEMPLATE_CONSENT=""   # 학부모 동의 요청 (없으면 문자로 나감)
# 배포 주소 (피드백·공지 카톡의 링크에 들어감). 비어 있으면 피드백·공지는 문자로 본문을 보냄
# 계좌이체 입금 계좌 (이용권 화면에 그대로 보임)
BANK_ACCOUNT=""   # 예: 국민 123456-78-901234 (예금주 홍길동)
# 관리자 화면(/admin)에 들어갈 수 있는 로그인 아이디 (쉼표로 여러 개)
ADMIN_LOGIN_IDS=""
APP_URL="https://내-주소.vercel.app"

# 처음 계정 만들 때만 씀 (npm run seed)
SEED_ACADEMY_NAME="현샘영수"
SEED_LOGIN_ID="hyunsaem"
SEED_PASSWORD="바꿔주세요1234"
SEED_SENDER_PHONE="01000000000"
# 테스트용 예시 학생 5명 넣기 (실사용이면 false)
SEED_SAMPLE_STUDENTS="true"

# ── 회원가입·요금제 ──
# 가입한 공부방이 문자(대체발송·공지)를 보낼 때 쓰는 발신번호 — 솔라피에 등록된 두나 번호
DEFAULT_SENDER_PHONE=""
# 무료 체험 일수 (안 넣으면 14). 요금제 가격·통수는 src/lib/pricing.ts
# TRIAL_DAYS="14"

# 토스페이먼츠 "API 개별 연동 키" (결제위젯 키 아님). 비우면 결제 버튼이 꺼짐
# 테스트용(토스 공개 문서 키): test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq / test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
TOSS_CLIENT_KEY=""   # Production 에는 live 키만. test 키가 들어가 있으면 결제가 자동으로 꺼짐
TOSS_SECRET_KEY=""

# 이용약관 화면(/terms)의 사업자 정보 — 토스 결제 심사에 필요
BUSINESS_NAME="두나"
BUSINESS_OWNER=""
BUSINESS_NO=""
BUSINESS_ADDRESS=""
BUSINESS_CONTACT=""

# 카카오 로그인 (선택) — 없으면 로그인 화면에 카카오 버튼이 안 보임. 카카오 개발자 콘솔 > 앱 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 콘솔 > 카카오 로그인 > 보안 > Client Secret 을 "사용함"으로 켰을 때만
KAKAO_CLIENT_SECRET=

# 구글 서치콘솔 소유 확인 메타태그 content 값 (네이버 값은 src/app/layout.tsx 에 바로 넣어 둠)
GOOGLE_SITE_VERIFICATION=""
